# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only video backups (pre-compression)
public/videos/conduit/_originals_DO_NOT_COMMIT/
public/images/conduit/gaps/_originals/

# Pre-crop / pre-compression backup originals (any *.original.* file)
*.original.*
.env*.local
node_modules/
.next/
.DS_Store

# Raw editing sources (Premiere assets, screen recordings, scans).
# Multi-GB and referenced by nothing in src/ — they live on disk, not in git.
/Manus AI Case Study/
/PD/
/demo/
/ConduitCommerce/
/art/

# Pre-compression originals of the work-card clips. The shipped versions are
# public/videos/work-fostr.mp4 and public/videos/work-clover.mp4.
public/videos/Fostr/
public/videos/Eden/

# Pre-optimisation media originals (local only)
.media-originals/
